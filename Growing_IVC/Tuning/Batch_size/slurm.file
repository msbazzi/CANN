#!/bin/bash
#SBATCH --job-name=tune-bs
#SBATCH --partition=amarsden
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=10:00:00
#SBATCH --array=0-3
#SBATCH --output=logs/tune-bs_%A_%a.out
#SBATCH --error=logs/tune-bs_%A_%a.err
set -euo pipefail
mkdir -p logs

module --force purge
module load devel math
module load py-tensorflow/2.10.0_py39

export PYTHONNOUSERSITE=0
export TF_CPP_MIN_LOG_LEVEL=2
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export TF_NUM_INTRAOP_THREADS=${SLURM_CPUS_PER_TASK}
export TF_NUM_INTEROP_THREADS=2
export CLUSTER_RUN=1

REPO_DIR="${SLURM_SUBMIT_DIR}/CANN"
SCRIPT="${REPO_DIR}/Growing_IVC/IVCCANN_discovered_augmentation_fiber_direction.py"
DATA_ROOT="${REPO_DIR}/Growing_IVC/data"
OUT_ROOT="${SLURM_SUBMIT_DIR}/out_bs"
mkdir -p "${OUT_ROOT}"

BS_LIST=(16 32 64 128)
BS="${BS_LIST[$SLURM_ARRAY_TASK_ID]}"
SEED=$((3000 + SLURM_ARRAY_TASK_ID))
OUT_DIR="${OUT_ROOT}/bs_${BS}"

srun -n 1 -c ${SLURM_CPUS_PER_TASK} python3 "${SCRIPT}" \
  --data_root "${DATA_ROOT}" \
  --out_root  "${OUT_DIR}" \
  --lr 2e-3 \
  --pen 0.01 \
  --batch "${BS}" \
  --reg L2 \
  --seed "${SEED}" \
  --fast

